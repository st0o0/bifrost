# Interface / config file name -> /etc/wireguard/<name>.conf
BIFROST_INTERFACE=wg0

# Supervisor: how often to check handshake freshness (seconds)
BIFROST_CHECK_INTERVAL=30
# Handshake age (seconds) that triggers a recovery episode
BIFROST_STALE_AFTER=135

# Recovery stage 1 — re-resolve DDNS endpoints (gentle, in place)
BIFROST_RESOLVE=on
BIFROST_RESOLVE_RETRIES=5
BIFROST_RESOLVE_BACKOFF=5

# Recovery stage 2 — active wg-quick down/up (netns preserved)
BIFROST_RECONNECT=on
BIFROST_RECONNECT_RETRIES=5
BIFROST_RECONNECT_BACKOFF=5

# Healthcheck
BIFROST_HEALTHCHECK=on
BIFROST_HEALTH_STALE_AFTER=180

# Liveness probe — active ICMP check for faster unreachability detection
# (opt-in; default off = trigger only on handshake age). Pings the /32 hosts
# from AllowedIPs (or BIFROST_PROBE_HOST); triggers recovery only when ALL are
# down for BIFROST_PROBE_FAILS rounds in a row.
BIFROST_PROBE=off
BIFROST_PROBE_INTERVAL=10
BIFROST_PROBE_FAILS=3
BIFROST_PROBE_TIMEOUT=2
# BIFROST_PROBE_HOST=10.100.99.1
