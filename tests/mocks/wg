#!/bin/sh
# Mock `wg`: log `set` invocations to $WG_MOCK_LOG; answer latest-handshakes from $WG_MOCK_HANDSHAKES.
if [ "$1" = "set" ]; then
  printf '%s\n' "$*" >> "${WG_MOCK_LOG:-/dev/null}"
fi
if [ "$1" = "show" ] && [ "$3" = "latest-handshakes" ]; then
  printf '%s\n' "${WG_MOCK_HANDSHAKES:-}"
fi
exit 0
